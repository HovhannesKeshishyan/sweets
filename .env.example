# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Required ---------------------------------------------------------------

# MongoDB connection string. Must be a REPLICA SET: checkout uses transactions.
# (MongoDB Atlas clusters are replica sets by default.)
NUXT_MONGODB_URI=

# Secret for hashing session and order-confirmation tokens. At least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NUXT_SESSION_SECRET=replace-with-a-long-random-secret

# Public base URL. Use https:// in production: it enables Secure, __Host- session cookies.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional ---------------------------------------------------------------

# Defaults used until an admin saves Settings in /admin/settings.
NUXT_PUBLIC_SITE_NAME=
NUXT_PUBLIC_DEFAULT_CURRENCY=USD

# true only behind a reverse proxy you control (Nginx, a PaaS router, …) so client IPs
# for rate limiting are read from X-Forwarded-For.
NUXT_TRUST_PROXY=false

# Cloudinary image uploads for the admin. Leave empty to paste image URLs instead.
NUXT_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=
NUXT_CLOUDINARY_FOLDER=hksweets/products
